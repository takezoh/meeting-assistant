{
  "manifest_version": 3,
  "name": "Meeting Assistant",
  "version": "0.1.0",
  "description": "Automatically records meeting tabs (used together with the resident Meeting Assistant app).",
  "key": "",
  "minimum_chrome_version": "126",
  "permissions": [
    "tabCapture",
    "offscreen",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.webex.com/*",
        "https://app.slack.com/*",
        "https://whereby.com/*",
        "https://*.whereby.com/*",
        "https://meet.jit.si/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.webex.com/*",
        "https://app.slack.com/*",
        "https://whereby.com/*",
        "https://*.whereby.com/*",
        "https://meet.jit.si/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
