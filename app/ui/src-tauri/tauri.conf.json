{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Assistant",
  "version": "0.1.0",
  "identifier": "dev.meeting-assistant.ui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Meeting Assistant",
        "width": 420,
        "height": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
