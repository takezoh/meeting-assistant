{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-assistant.invalid/contracts/ipc/methods.schema.json",
  "title": "EngineControlMethods",
  "description": "The closed method set of the engine control channel with each method's params. Responses that carry a session_snapshot use $defs/session_snapshot, whose state is the closed state enum.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "engine.hello"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client_protocol",
            "client_capabilities"
          ],
          "properties": {
            "client_protocol": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "client_capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "indicator",
                  "cancel",
                  "notify"
                ]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "session.snapshot"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "session.start"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "session.stop"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "session.pause"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "session.resume"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "session.discard"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "session.cancel_arming"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "session.extend_hysteresis"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extend"
          ],
          "properties": {
            "extend": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "mode.set"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "mode"
          ],
          "properties": {
            "scope": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "global",
                    "class",
                    "adapter"
                  ]
                },
                "class": {
                  "enum": [
                    "desktop",
                    "browser"
                  ]
                },
                "adapter_id": {
                  "type": "string"
                }
              }
            },
            "mode": {
              "enum": [
                "auto",
                "ask",
                "manual"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "artifact.edit"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "edit_revision"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "edit_revision": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "meeting.delete"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meeting_id"
          ],
          "properties": {
            "meeting_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "diagnostics.export"
        },
        "params": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "const": "engine.shutdown"
        },
        "params": {
          "type": "null"
        }
      }
    }
  ],
  "$defs": {
    "state": {
      "enum": [
        "idle",
        "candidate",
        "arming",
        "recording",
        "paused",
        "ending",
        "finalizing",
        "completed",
        "discarded",
        "interrupted",
        "failed"
      ]
    },
    "session_snapshot": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    }
  }
}
