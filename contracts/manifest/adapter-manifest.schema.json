{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-assistant.invalid/contracts/manifest/adapter-manifest.schema.json",
  "title": "AdapterManifest",
  "description": "Payload of a signed adapter manifest. Activation additionally requires every artifact digest to match the file on disk.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "adapter_id",
    "version",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "minimum": 1
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "sha256",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://(github\\.com|objects\\.githubusercontent\\.com)/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "pinned_extension_id": {
      "type": "string",
      "pattern": "^[a-p]{32}$",
      "description": "The browser extension identifier the detection-only channel pins its Origin check to."
    }
  }
}
